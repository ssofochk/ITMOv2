    {
      "parameters": {
        "jsCode": "\nconst ctx = $('PR context').first().json;\nconst blocks = $('Prepare review prompt').first().json.blocks;\n\nconst raw = $json.text ?? $json.output;\n\nif (typeof raw !== 'string' || !raw.trim()) {\n  throw new Error('Model returned no review');\n}\n\nconst clean = raw\n  .trim()\n  .replace(/^```(?:json)?\\s*/i, '')\n  .replace(/\\s*```$/, '');\n\nlet reviews;\n\ntry {\n  reviews = JSON.parse(clean);\n} catch {\n  throw new Error('Model returned invalid JSON: ' + clean);\n}\n\nif (!Array.isArray(reviews)) {\n  throw new Error('Expected a JSON array');\n}\n\nif (!ctx.head_sha) {\n  throw new Error('Missing PR commit SHA');\n}\n\nconst model = ctx.command === '/make_ai_review'\n  ? 'GPT-5.4-mini'\n  : 'GPT-5.2';\n\nconst comments = blocks.map(block => {\n  const matches = reviews.filter(r => r.id === block.id);\n\n  if (matches.length !== 1) {\n    throw new Error(\n      `Expected one review for block ${block.id}`\n    );\n  }\n\n  const review = matches[0];\n\n  if (typeof review.body !== 'string' || !review.body.trim()) {\n    throw new Error(`Empty review for block ${block.id}`);\n  }\n\n  return {\n    path: block.path,\n    line: block.line,\n    side: block.side,\n    body: `**AI Review — ${model}**\\n\\n${review.body.trim()}`\n  };\n});\n\nreturn [{\n  json: {\n    ...ctx,\n    review_url: ctx.pr_url + '/reviews',\n    review_payload: {\n      commit_id: ctx.head_sha,\n      event: 'COMMENT',\n      body: `AI code review — ${model}\\nПроверено блоков: ${comments.length}`,\n      comments\n    }\n  }\n}];"
      },
