    {
      "parameters": {
        "jsCode": "const e = $json.body && typeof $json.body === 'object' ? $json.body : $json;\nif (e.action !== 'created' || !e.issue?.pull_request || e.issue.state !== 'open' || e.comment?.user?.type === 'Bot') return [];\nconst command = (e.comment?.body ?? '').trim();\nif (!['/make_ai_review','/make_other_ai_review'].includes(command)) return [];\n// Restrict billable commands to trusted repository participants.\nif (e.comment?.user?.login !== 'ssofochk') return [];\nconst owner = e.repository?.owner?.login;\nconst repo = e.repository?.name;\nconst number = e.issue.number;\nif (!owner || !repo || !Number.isInteger(number)) throw new Error('Missing repository or PR number');\nreturn [{json:{command, owner, repo, number, pr_url:'https://api.github.com/repos/'+encodeURIComponent(owner)+'/'+encodeURIComponent(repo)+'/pulls/'+number, comment_url:'https://api.github.com/repos/'+encodeURIComponent(owner)+'/'+encodeURIComponent(repo)+'/issues/'+number+'/comments'}}];"
      },
